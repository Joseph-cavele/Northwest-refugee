# Copy to .env and fill in. src/config/env.js validates every variable at boot and exits
# with a readable list if anything is missing or malformed.

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent (defaults by NODE_ENV)
LOG_LEVEL=

# Database — Atlas must stay in af-south-1 (Cape Town) for data residency.
MONGO_URI=mongodb://127.0.0.1:27017/nwhr

# Auth. JWT_CHALLENGE_SECRET must DIFFER from JWT_SECRET: separate keys are what stop an
# MFA-challenge token being replayed as an access token.
#   openssl rand -hex 32
JWT_SECRET=
JWT_CHALLENGE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14

# LEAVE THIS BLANK LOCALLY. It is only correct once the app is actually served from that
# domain over HTTPS. A browser discards any cookie whose Domain does not match the host it
# came from, so a value here on localhost silently drops the refresh cookie — the symptom
# is signing in successfully and being signed out again by the next page load, with nothing
# in any log to explain it.
#
# The guard in utils/tokens.js only applies the domain when NODE_ENV is production, which
# was enough under Express because `npm run dev` meant development. `next start` runs in
# production mode even on a laptop, so the guard no longer saves you here.
COOKIE_DOMAIN=

# Field-level encryption for permit numbers (POPIA). 64 hex characters:
#   openssl rand -hex 32
# Rotating this makes every stored permit number undecryptable. Without it, any write
# touching a permit number fails — by design, so nothing is ever stored in the clear.
ENCRYPTION_KEY=

# Security tuning
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Organisation identity for s18A tax receipts. Without S18A_PBO_NUMBER the system sends a
# plain acknowledgement instead of a tax certificate — a receipt missing the PBO approval
# number is not valid for a donor to claim against.
ORG_NAME=North West House of Refuge
ORG_ADDRESS=
S18A_PBO_NUMBER=

# Cloudinary — authenticated delivery only; beneficiary documents are never public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (Meta). Nothing here describes the public URL: Meta signs only the
# raw request BODY, so the callback address is configured in the Meta dashboard alone.
# From Meta app dashboard > WhatsApp > API Setup. This is the ID of the sending number,
# NOT the number itself.
WHATSAPP_PHONE_NUMBER_ID=
# System-user token. A temporary 24h token is fine for testing; generate a permanent one
# from Business Settings > System Users before go-live.
WHATSAPP_ACCESS_TOKEN=
# App Settings > Basic > App Secret. Verifies X-Hub-Signature-256 and is the ONLY
# authentication the inbound webhook has — without it every webhook is refused.
WHATSAPP_APP_SECRET=
# Any string you choose; type the same value into the webhook config in the dashboard.
WHATSAPP_VERIFY_TOKEN=
# The display number, used only to build the wa.me link on the public help guide.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v21.0

# Paystack. Settings > API Keys & Webhooks. The SECRET key also verifies webhook
# signatures (HMAC-SHA512 over the raw body) and must never reach the browser — the
# public key is the one the frontend initialises a payment with.
# Point the Paystack webhook at: https://<your-host>/api/v1/payments/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend (email). Without RESEND_API_KEY, invite and reset links are logged instead of
# sent, so the flows stay testable in development.
RESEND_API_KEY=
EMAIL_FROM=NWHR <noreply@example.com>
MAIL_REPLY_TO=

# --- Models: CLASSIFICATION ONLY -------------------------------------------------------
# Both providers below do one job — pick which of our written screens best fits what a
# person typed. Neither ever composes anything a beneficiary reads; that text lives in
# modules/guide/guide.content.js and whatsapp/prompts.js and is reviewed in version
# control. Leaving either blank is safe: that channel falls back to its numbered menu.
#
# TWO VENDORS ON PURPOSE. The WhatsApp bot is on OpenAI and the website help guide is on
# Gemini. They reach the same `classify` contract and fail the same way, so an outage or a
# suspended key at one vendor costs one channel rather than both.
#
# BOTH KEYS ARE SERVER-SIDE ONLY. Neither is prefixed NEXT_PUBLIC_ and neither may be —
# these are metered endpoints billed to a nonprofit, and a key in the browser bundle is a
# key anyone can extract and run a loop against.

# OpenAI — the WhatsApp bot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini — the website help guide (the chat widget on the public site).
# Get a key at https://aistudio.google.com/apikey
# Flash-lite because the task is choosing one label off a ten-item list. CHECK THE MODEL
# NAME against Google's current list before deploying: a name the API does not recognise
# returns 404, which the guide reads as "no match" and answers with the menu — so a typo
# here degrades quietly instead of failing loudly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Hard monthly ceiling on model spend, in rands. SHARED ACROSS BOTH PROVIDERS — it caps the
# organisation's money, not one vendor's. Once the calendar month's total reaches this,
# classification stops and the bot and guide fall back to their numbered menus — which they
# already do on a timeout, so nothing beneficiary-facing breaks. It resumes automatically on
# the first of the next month. 0 disables the model entirely.
#
# The name still says OPENAI_ for the same reason the database is still called `test`:
# renaming it is a deployment change, not a code one, and a half-renamed budget variable
# silently reverts to the 300 default. Rename it in the same change that updates the
# deployed environment, not before.
OPENAI_MONTHLY_BUDGET_ZAR=300
# Used only to price USD tokens in rands for that ceiling. A rough rate is fine.
# Both vendors publish in USD, so one rate covers both.
OPENAI_USD_ZAR_RATE=18.5

# Scheduled jobs (/api/v1/cron/*). Generate with: openssl rand -hex 32
# Required in production: the cron endpoints fail closed without it.
CRON_SECRET=
