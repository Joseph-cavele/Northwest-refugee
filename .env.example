# Copy to .env and fill in. src/config/env.js validates every variable at boot and exits
# with a readable list if anything is missing or malformed.

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent (defaults by NODE_ENV)
LOG_LEVEL=

# Database — Atlas must stay in af-south-1 (Cape Town) for data residency.
MONGO_URI=mongodb://127.0.0.1:27017/nwhr

# Auth. JWT_CHALLENGE_SECRET must DIFFER from JWT_SECRET: separate keys are what stop an
# MFA-challenge token being replayed as an access token.
#   openssl rand -hex 32
JWT_SECRET=
JWT_CHALLENGE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14
COOKIE_DOMAIN=

# Field-level encryption for permit numbers (POPIA). 64 hex characters:
#   openssl rand -hex 32
# Rotating this makes every stored permit number undecryptable. Without it, any write
# touching a permit number fails — by design, so nothing is ever stored in the clear.
ENCRYPTION_KEY=

# Security tuning
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Organisation identity for s18A tax receipts. Without S18A_PBO_NUMBER the system sends a
# plain acknowledgement instead of a tax certificate — a receipt missing the PBO approval
# number is not valid for a donor to claim against.
ORG_NAME=North West House of Refuge
ORG_ADDRESS=
S18A_PBO_NUMBER=

# Cloudinary — authenticated delivery only; beneficiary documents are never public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (Meta). Nothing here describes the public URL: Meta signs only the
# raw request BODY, so the callback address is configured in the Meta dashboard alone.
# From Meta app dashboard > WhatsApp > API Setup. This is the ID of the sending number,
# NOT the number itself.
WHATSAPP_PHONE_NUMBER_ID=
# System-user token. A temporary 24h token is fine for testing; generate a permanent one
# from Business Settings > System Users before go-live.
WHATSAPP_ACCESS_TOKEN=
# App Settings > Basic > App Secret. Verifies X-Hub-Signature-256 and is the ONLY
# authentication the inbound webhook has — without it every webhook is refused.
WHATSAPP_APP_SECRET=
# Any string you choose; type the same value into the webhook config in the dashboard.
WHATSAPP_VERIFY_TOKEN=
# The display number, used only to build the wa.me link on the public help guide.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v21.0

# Paystack. Settings > API Keys & Webhooks. The SECRET key also verifies webhook
# signatures (HMAC-SHA512 over the raw body) and must never reach the browser — the
# public key is the one the frontend initialises a payment with.
# Point the Paystack webhook at: https://<your-host>/api/v1/payments/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend (email). Without RESEND_API_KEY, invite and reset links are logged instead of
# sent, so the flows stay testable in development.
RESEND_API_KEY=
EMAIL_FROM=NWHR <noreply@example.com>
MAIL_REPLY_TO=

# OpenAI — CLASSIFICATION ONLY. The model picks which of our written screens best fits
# what a visitor typed; it never composes anything a person reads. Leaving this blank is
# safe: the help widget falls back to its menu.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard monthly ceiling on model spend, in rands. Once the calendar month's total reaches
# this, classification stops and the bot and guide fall back to their numbered menus —
# which they already do on a timeout, so nothing beneficiary-facing breaks. It resumes
# automatically on the first of the next month. 0 disables the model entirely.
OPENAI_MONTHLY_BUDGET_ZAR=300
# Used only to price USD tokens in rands for that ceiling. A rough rate is fine.
OPENAI_USD_ZAR_RATE=18.5

# Scheduled jobs (/api/v1/cron/*). Generate with: openssl rand -hex 32
# Required in production: the cron endpoints fail closed without it.
CRON_SECRET=
